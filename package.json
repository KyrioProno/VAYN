{
  "name": "vayn",
  "private": true,
  "version": "0.1.0",
  "description": "VAYN — jeu narratif de survie post-apocalyptique (chapitre I : Signal faible)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
